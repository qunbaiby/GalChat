{
    "guides": [
        {
            "id": "schedule_onboarding_guide",
            "title": "行程安排新手引导",
            "guide_category": "schedule_onboarding",
            "show_completion_toast": false,
            "auto_start_after_intro": true,
            "steps": [
                {
                    "id": "open_schedule_panel",
                    "type": "wait_action",
                    "step_category": "schedule",
                    "title": "打开行程安排",
                    "text": "欢迎来到主场景。先点击主行动按钮里的“行程安排”，我会带你完成第一次课程安排教学。",
                    "wait_action": "open_schedule",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.main_action",
                    "feature_updates": {
                        "main.main_action": true,
                        "main.affection": false
                    },
                    "scene_hint": "如果当前主按钮不是“行程安排”，请先确认当前是否处于适合安排课程的时段。"
                },
                {
                    "id": "explain_schedule_tabs",
                    "type": "wait_action",
                    "step_category": "schedule",
                    "title": "课程类型切换",
                    "text": "点击上方课程分类，看看对应的课程列表。",
                    "wait_action": "activity_switch_category",
                    "target_scene": "activity",
                    "requires_scene": "activity",
                    "target_mode": "category_tabs",
                    "hide_until_scene_ready": true,
                    "highlight_padding": 0
                },
                {
                    "id": "explain_schedule_list",
                    "type": "wait_action",
                    "step_category": "schedule",
                    "title": "课程列表区域",
                    "text": "选择一门课程，把它安排到下方行程槽位。",
                    "wait_action": "activity_add_course",
                    "target_scene": "activity",
                    "requires_scene": "activity",
                    "target_mode": "activity_list",
                    "focus_targets": [
                        {
                            "target_mode": "category_tabs",
                            "highlight_padding": 0
                        }
                    ],
                    "hide_until_scene_ready": true,
                    "skip_if_action_already_done": true,
                    "highlight_padding": 0
                },
                {
                    "id": "explain_schedule_slots",
                    "type": "wait_action",
                    "step_category": "schedule",
                    "title": "行程安排槽位",
                    "text": "继续挑选课程，把本周 5 个行程槽位全部排满。",
                    "wait_action": "activity_schedule_full",
                    "target_scene": "activity",
                    "requires_scene": "activity",
                    "target_mode": "schedule_slots",
                    "focus_targets": [
                        {
                            "target_mode": "category_tabs",
                            "highlight_padding": 0
                        },
                        {
                            "target_mode": "activity_list",
                            "highlight_padding": 0
                        }
                    ],
                    "hide_until_scene_ready": true,
                    "skip_if_action_already_done": true,
                    "highlight_padding": 0
                },
                {
                    "id": "explain_main_story_slot",
                    "type": "wait_action",
                    "step_category": "schedule",
                    "title": "主线剧情占位槽",
                    "text": "特殊槽位代表固定主线剧情，不占用自由选课位置。",
                    "wait_action": "activity_click_main_event_slot",
                    "target_scene": "activity",
                    "requires_scene": "activity",
                    "target_mode": "main_event_slot",
                    "hide_until_scene_ready": true,
                    "skip_if_target_missing": true,
                    "highlight_padding": 4
                },
                {
                    "id": "explain_schedule_preview",
                    "type": "wait_action",
                    "step_category": "schedule",
                    "title": "属性预览面板",
                    "text": "右侧是本周安排的属性预览面板，会根据当前排课情况实时展示心情、金币消耗和各项属性的预计变化。",
                    "wait_action": "activity_click_preview_panel",
                    "target_scene": "activity",
                    "requires_scene": "activity",
                    "target_path": "BackgroundPanel/Margin/MainHBox/RightPanel",
                    "hide_until_scene_ready": true,
                    "highlight_padding": 6
                },
                {
                    "id": "execute_schedule_plan",
                    "type": "wait_action",
                    "step_category": "schedule",
                    "title": "执行课程安排",
                    "text": "课程已经排满了。点击右下角执行按钮，经过过渡界面后进入课程执行面板。",
                    "wait_action": "activity_execute_schedule",
                    "target_scene": "activity",
                    "requires_scene": "activity",
                    "target_path": "BackgroundPanel/Margin/MainHBox/RightPanel/Margin/VBox/ExecuteButton",
                    "hide_until_scene_ready": true
                },
                {
                    "id": "explain_execution_info_panel",
                    "type": "wait_action",
                    "step_category": "schedule_execution",
                    "title": "当前行程信息",
                    "text": "这里是 Luna 正在进行的行程信息。先点击上方信息面板，继续下一步说明。",
                    "wait_action": "schedule_execution_click_info_panel",
                    "target_scene": "schedule_execution",
                    "requires_scene": "schedule_execution",
                    "target_mode": "info_panel",
                    "hide_until_scene_ready": true
                },
                {
                    "id": "explain_execution_track_panel",
                    "type": "wait_action",
                    "step_category": "schedule_execution",
                    "title": "本周行程轨道",
                    "text": "这里会展示本周全部行程。点击高亮区域继续。",
                    "wait_action": "schedule_execution_finish_intro",
                    "target_scene": "schedule_execution",
                    "requires_scene": "schedule_execution",
                    "target_mode": "track_panel",
                    "hide_until_scene_ready": true,
                    "overlay_options": {
                        "background_wait_action": "schedule_execution_finish_intro",
                        "capture_focus_clicks": true,
                        "focus_wait_action": "schedule_execution_finish_intro"
                    }
                },
                {
                    "id": "close_schedule_result_popup",
                    "type": "wait_action",
                    "step_category": "stats",
                    "title": "关闭本周结算",
                    "text": "本周结算已经完成。先点击结算面板下方的关闭按钮，回到主界面后再继续查看属性面板。",
                    "wait_action": "close_schedule_result_popup",
                    "target_scene": "schedule_execution",
                    "requires_scene": "schedule_execution",
                    "target_mode": "result_close_button",
                    "hide_until_scene_ready": true
                },
                {
                    "id": "explain_post_schedule_stats",
                    "type": "wait_action",
                    "step_category": "stats",
                    "title": "先看看属性变化",
                    "text": "行程和互动会改变 Luna 的属性。点击属性面板查看。",
                    "wait_action": "click_main_stats",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.stats",
                    "hide_until_scene_ready": true,
                    "overlay_options": {
                        "capture_focus_clicks": true,
                        "focus_wait_action": "click_main_stats"
                    }
                },
                {
                    "id": "open_wechat_after_schedule",
                    "type": "wait_action",
                    "step_category": "wechat",
                    "title": "看看新的微聊消息",
                    "text": "静老师发来了新消息。点击微聊查看。",
                    "wait_action": "open_wechat",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.wechat",
                    "hide_until_scene_ready": true
                },
                {
                    "id": "explain_wechat_recent_chats",
                    "type": "wait_action",
                    "step_category": "wechat",
                    "title": "微聊聊天列表",
                    "text": "点击带未读提示的静老师会话。",
                    "wait_action": "wechat_select_chat",
                    "target_scene": "wechat",
                    "requires_scene": "wechat",
                    "target_mode": "recent_chats",
                    "hide_until_scene_ready": true
                },
                {
                    "id": "explain_wechat_chat_session",
                    "type": "wait_action",
                    "step_category": "wechat",
                    "title": "先把消息看完",
                    "text": "点击静老师发来的消息，先把内容看完。",
                    "wait_action": "wechat_view_chat_session",
                    "target_scene": "wechat",
                    "requires_scene": "wechat",
                    "target_mode": "chat_session",
                    "hide_until_scene_ready": true
                },
                {
                    "id": "explain_wechat_fixed_options",
                    "type": "wait_action",
                    "step_category": "wechat",
                    "title": "选择你的回复",
                    "text": "静老师刚发来的内容已经看到了。现在高亮的是下方玩家回复选项区域，请点击一个回复选项，把这句回答填进输入框。",
                    "wait_action": "wechat_select_player_option",
                    "target_scene": "wechat",
                    "requires_scene": "wechat",
                    "target_mode": "fixed_options",
                    "hide_until_scene_ready": true
                },
                {
                    "id": "explain_wechat_fixed_conversation",
                    "type": "wait_action",
                    "step_category": "wechat",
                    "title": "把整段对话发完",
                    "text": "点击发送并完成整段对话。结束后，再点击高亮区域继续。",
                    "wait_action": "wechat_acknowledge_fixed_conversation_finished",
                    "target_scene": "wechat",
                    "requires_scene": "wechat",
                    "target_mode": "input_edit",
                    "hide_until_scene_ready": true
                },
                {
                    "id": "close_wechat_after_read",
                    "type": "wait_action",
                    "step_category": "wechat",
                    "title": "关闭微聊",
                    "text": "这段固定对话已经结束。现在点击右上角关闭按钮；回到主场景后，先看看刚刚更新的近期目标。",
                    "wait_action": "close_wechat_panel",
                    "target_scene": "wechat",
                    "requires_scene": "wechat",
                    "target_mode": "close_button",
                    "hide_until_scene_ready": true
                },
                {
                    "id": "explain_main_goal_panel",
                    "type": "wait_action",
                    "step_category": "goal",
                    "title": "看看近期目标",
                    "text": "静老师约好周六专项辅导。点击近期目标查看。",
                    "wait_action": "click_main_goal",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.goal",
                    "hide_until_scene_ready": true,
                    "overlay_options": {
                        "capture_focus_clicks": true,
                        "focus_wait_action": "click_main_goal",
                        "focus_handler_method": "open_main_goal_story_from_guide"
                    }
                },
                {
                    "id": "wait_first_main_story_auto_open",
                    "type": "wait_action",
                    "step_category": "chat",
                    "title": "继续主线",
                    "text": "",
                    "wait_action": "first_main_story_auto_opened",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "hide_overlay": true,
                    "hide_until_scene_ready": true
                },
                {
                    "id": "choose_topic_after_goal",
                    "type": "wait_action",
                    "step_category": "chat",
                    "title": "选择主线话题",
                    "text": "点击专项辅导话题，开始最多 4 回合的主线对话。",
                    "wait_action": "select_main_chat_topic",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "target_mode": "topic_options",
                    "hide_until_scene_ready": true,
                    "highlight_padding": 0.0
                },
                {
                    "id": "explain_guided_ai_round_limit",
                    "type": "wait_action",
                    "step_category": "chat",
                    "title": "留意剩余回合",
                    "text": "左上角显示剩余回合。点击回合卡后开始输入。",
                    "wait_action": "acknowledge_guided_ai_round_limit",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.ai_rounds",
                    "hide_until_scene_ready": true,
                    "overlay_options": {
                        "capture_focus_clicks": true,
                        "focus_wait_action": "acknowledge_guided_ai_round_limit"
                    }
                },
                {
                    "id": "finish_first_chat_after_goal",
                    "type": "wait_action",
                    "step_category": "chat",
                    "title": "在限定回合内聊完",
                    "text": "每次发送使用 1 个回合。对话不耗行动力，结束后推进 30 分钟。",
                    "wait_action": "finish_first_main_chat_after_goal",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "hide_overlay": true,
                    "hide_until_scene_ready": true
                },
                {
                    "id": "inspect_main_panels_after_interact",
                    "type": "wait_action",
                    "step_category": "interaction",
                    "title": "留意时间与天气",
                    "text": "时间与天气会随剧情变化。点击高亮区域继续。",
                    "wait_action": "inspect_main_panels_after_interact",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.weather",
                    "hide_until_scene_ready": true,
                    "overlay_options": {
                        "capture_focus_clicks": true,
                        "focus_wait_action": "inspect_main_panels_after_interact"
                    }
                },
                {
                    "id": "explain_main_affection_button",
                    "type": "wait_action",
                    "step_category": "affection",
                    "title": "看看情感入口",
                    "text": "互动会影响 Luna 的情感状态。点击情感按钮查看。",
                    "wait_action": "open_affection",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.affection",
                    "hide_until_scene_ready": true,
                    "overlay_options": {
                        "capture_focus_clicks": true,
