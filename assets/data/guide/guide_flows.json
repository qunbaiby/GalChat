                    "feature_updates": {
                        "main.chat": true
                    }
                }
            ],
            "completion_feature_updates": {
                "main.main_action": true,
                "main.affection": true
            }
        },
        {
            "id": "main_intro_guide",
            "title": "Luna新手引导",
            "guide_category": "main_intro",
            "auto_start_after_intro": true,
            "steps": [
                {
                    "id": "open_affection",
                    "type": "message",
                    "title": "先看看当前状态",
                    "text": "先打开好感面板，确认 Luna 当前的情感阶段和心情状态。完成这一步后，我再帮你解锁下一个功能。",
                    "wait_action": "open_affection",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.affection",
                    "skip_if_action_already_done": true,
                    "feature_updates": {
                        "main.affection": true,
                        "main.chat": false,
                        "main.main_action": false,
                        "main.wechat": false,
                        "main.diary": false,
                        "main.wardrobe": false
                    }
                },
                {
                    "id": "open_main_chat",
                    "type": "message",
                    "title": "和 Luna 聊一句",
                    "text": "接着试试主场景聊天入口。先和 Luna 打个招呼，确认你已经熟悉主互动区的位置。",
                    "wait_action": "open_main_chat",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.chat",
                    "feature_updates": {
                        "main.chat": true
                    }
                },
                {
                    "id": "open_wechat",
                    "type": "message",
                    "title": "试试手机消息",
                    "text": "接着打开微信，熟悉一下手机里的固定消息和社交入口。",
                    "wait_action": "open_wechat",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.wechat",
                    "skip_if_action_already_done": true,
                    "feature_updates": {
                        "main.wechat": true
                    }
                },
                {
                    "id": "open_diary",
                    "type": "message",
                    "title": "记录今天的内容",
                    "text": "最后打开日记功能看一眼，完成后这轮基础功能引导就结束了。",
                    "wait_action": "open_diary",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.diary",
                    "skip_if_action_already_done": true,
                    "feature_updates": {
                        "main.diary": true,
                        "main.wardrobe": true
                    }
                },
                {
                    "id": "finish_main_intro",
                    "type": "message",
                    "title": "基础功能已解锁",
                    "text": "主场景的基础入口你已经熟悉了。接下来你可以继续自由探索，或者稍后再进入地图与剧情演示引导。",
                    "auto_advance": true
                }
            ],
            "completion_feature_updates": {
                "main.affection": true,
                "main.chat": true,
                "main.main_action": true,
                "main.wechat": true,
                "main.diary": true,
                "main.wardrobe": true
            }
        },
        {
            "id": "day6_library_guidance_guide",
            "title": "周六专项辅导引导",
            "guide_category": "day6_library_guidance",
            "show_completion_toast": false,
            "auto_start_after_intro": false,
            "steps": [
                {
                    "id": "open_map_for_saturday_guidance",
                    "type": "wait_action",
                    "title": "别忘了周六的约定",
                    "text": "今天就是和静约好为 Luna 进行专项辅导的日子。点击“外出”，带 Luna 前往学校图书馆吧。",
                    "wait_action": "open_map",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.main_action",
                    "hide_until_scene_ready": true,
                    "overlay_options": {
                        "capture_focus_clicks": true,
                        "focus_wait_action": "open_map",
                        "focus_handler_method": "open_map_from_guide"
                    },
                    "feature_updates": {
                        "main.main_action": true
                    }
                },
                {
                    "id": "select_art_academy_for_guidance",
                    "type": "wait_action",
                    "title": "前往江屿现代艺术大学",
                    "text": "地图默认停在青屿街。点击底部的区域卡片，可以查看该区域内的所有地点。现在选择“江屿现代艺术大学”。",
                    "wait_action": "select_map_area",
                    "action_payload_match": {
                        "area_id": "art_academy"
                    },
                    "target_scene": "world_map",
                    "requires_scene": "world_map",
                    "target_mode": "area_by_id",
                    "target_id": "art_academy",
                    "hide_until_scene_ready": true,
                    "highlight_padding": 10.0
                },
                {
                    "id": "select_library_for_guidance",
                    "type": "wait_action",
                    "title": "静已经在等你们了",
                    "text": "看样子静已经在图书馆等你们了。点击“图书馆”，打开右侧地点详情。",
                    "wait_action": "select_map_location",
                    "action_payload_match": {
                        "location_id": "library"
                    },
                    "target_scene": "world_map",
                    "requires_scene": "world_map",
                    "target_mode": "location_by_id",
                    "target_id": "library",
                    "hide_until_scene_ready": true,
                    "highlight_padding": 0.0,
                    "overlay_options": {
                        "panel_placement": "below"
                    }
                },
                {
                    "id": "enter_library_guidance_story",
                    "type": "wait_action",
                    "title": "赴约进行专项辅导",
                    "text": "右侧详情显示今天有可触发的主线剧情。点击“进入剧情”，带 Luna 赴静的周六专项辅导之约。",
                    "wait_action": "enter_location_detail",
                    "action_payload_match": {
                        "location_id": "library"
                    },
                    "target_scene": "location_detail",
                    "requires_scene": "location_detail",
                    "target_path": "MainPanel/Margin/VBox/EnterButton",
                    "hide_until_scene_ready": true,
                    "highlight_padding": 10.0,
                    "overlay_options": {
                        "panel_placement": "left"
                    }
                },
                {
                    "id": "wait_library_guidance_story_finished",
                    "type": "wait_action",
                    "wait_action": "story_finished",
                    "action_payload_match": {
                        "script_id": "jing_library_guidance"
