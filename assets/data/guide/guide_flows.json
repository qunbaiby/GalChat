                        "focus_handler_method": "open_affection_from_guide"
                    },
                    "feature_updates": {
                        "main.affection": true
                    }
                },
                {
                    "id": "explain_main_affection_panel",
                    "type": "wait_action",
                    "step_category": "affection",
                    "title": "查看情感状态",
                    "text": "这里记录你们的情感阶段。看完后关闭面板。",
                    "wait_action": "close_affection_panel",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.affection_panel",
                    "hide_until_scene_ready": true
                },
                {
                    "id": "prompt_start_companion_journey",
                    "type": "wait_action",
                    "step_category": "affection",
                    "title": "陪伴开始了",
                    "text": "要提高和 Luna 的好感度，就需要多与 Luna 互动。点击任意空白处，继续了解互动需要注意的事项。",
                    "wait_action": "start_companion_journey",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "overlay_options": {
                        "center_panel_when_no_focus": true,
                        "background_wait_action": "start_companion_journey"
                    }
                },
                {
                    "id": "explain_interaction_energy",
                    "type": "wait_action",
                    "step_category": "interaction",
                    "title": "合理规划行动力",
                    "text": "与 Luna 互动需要消耗行动力。合理规划行动力，与 Luna 进行互动吧。点击高亮的行动力区域继续。",
                    "wait_action": "acknowledge_interaction_energy",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.energy",
                    "hide_until_scene_ready": true,
                    "overlay_options": {
                        "capture_focus_clicks": true,
                        "focus_wait_action": "acknowledge_interaction_energy"
                    }
                },
                {
                    "id": "open_first_daily_chat",
                    "type": "wait_action",
                    "step_category": "chat",
                    "title": "先聊聊天吧",
                    "text": "先试试与 Luna 聊聊天吧，聊什么话题都可以哦。点击聊天按钮，开启日常聊天。",
                    "wait_action": "open_first_daily_chat",
                    "target_scene": "main",
                    "requires_scene": "main",
                    "highlight_feature": "main.chat",
                    "hide_until_scene_ready": true,
                    "overlay_options": {
                        "capture_focus_clicks": true,
