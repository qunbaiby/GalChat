[sub_resource type="Shader" id="Shader_AvatarCircle"]
code = "shader_type canvas_item;

uniform float portrait_zoom : hint_range(1.0, 1.5) = 1.28;

void fragment() {
	vec2 centered = UV - vec2(0.5);
	vec2 sample_uv = centered / portrait_zoom + vec2(0.5);
	float distance_from_center = length(centered);
	float edge = 1.0 - smoothstep(0.47, 0.5, distance_from_center);
	vec4 source = texture(TEXTURE, sample_uv);
	COLOR = vec4(source.rgb, source.a * edge) * COLOR;
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_AvatarCircle"]
shader = SubResource("Shader_AvatarCircle")
shader_parameter/portrait_zoom = 1.0

